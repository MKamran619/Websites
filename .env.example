# Local environment for `netlify dev`.
#
# Copy to .env and fill in the blanks. .env is gitignored - never commit it,
# and never copy these values into src/environments/ (that ships to the
# browser).
#
# In production these same variables are set in the Netlify UI:
# Site configuration -> Environment variables.

# --- Supabase ---------------------------------------------------------------
# Public. Same values the site already uses in src/environments/environment.ts.
SUPABASE_URL=https://enijmkzmranhirwajvms.supabase.co
SUPABASE_ANON_KEY=sb_publishable_SQKWNZH8Hti-b9kGCOcScQ_-_BSQQfm

# SECRET. Supabase dashboard -> Project Settings -> API -> service_role.
# Bypasses every RLS policy in the project. Server-side only.
# Needed to store transcripts and leads; the bot answers without it.
SUPABASE_SERVICE_ROLE_KEY=

# Any random string. Salts the hashed client identifier stored with a
# conversation, so the stored hashes are not reversible with a rainbow table.
CHAT_HASH_SALT=change-me-to-any-random-string

# --- Chat assistant ---------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to stay in the free retrieval mode.
# Set it (and run `npm install @anthropic-ai/sdk`) to switch on AI mode.
ANTHROPIC_API_KEY=

# Optional. "retrieval" forces the free mode even when a key is present.
CHAT_MODE=

# Optional. Defaults to claude-opus-5. Use claude-haiku-4-5 for a cheaper bot.
CHAT_MODEL=
